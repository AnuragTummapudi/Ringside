# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google OAuth - create a Web application OAuth client in Google Cloud
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Use a long, unique random value in each environment.
AUTH_SESSION_SECRET=
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false

# Neon Postgres - required in production. Local development falls back to data/ringside.json.
DATABASE_URL=

# Anthropic
ANTHROPIC_API_KEY=

# Maya Research TTS
MAYA_API_KEY=
RINGSIDE_VOICE_ID=Ananya
REP_VOICE_ID=Arjun

# Twilio
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_RINGSIDE_NUMBER=+1XXXXXXXXXX
TWILIO_REP_NUMBER=+91XXXXXXXXXX
# Browser takeover only: create a Twilio API Key and a Voice TwiML App whose
# Voice URL is https://your-public-host/twiml/browser-takeover.
TWILIO_API_KEY_SID=SKxxx
TWILIO_API_KEY_SECRET=xxx
TWILIO_TWIML_APP_SID=APxxx

# ngrok tunnel URL — no trailing slash
NGROK_URL=https://your-tunnel.ngrok-free.app

# Production guardrails
RINGSIDE_API_TOKEN=
PUBLIC_OUTBOUND_CALLS_ENABLED=false
REQUIRE_TWILIO_SIGNATURES=false
TTS_CONCURRENCY=3
TTS_TIMEOUT_MS=8000
AUDIO_RETENTION_MS=900000
